# Integration Environment Configuration
# This file configures the RF automation system to use mock equipment

# ============================================================================
# MOCK EQUIPMENT MODE
# ============================================================================
USE_MOCK_EQUIPMENT=true

# ============================================================================
# MOCK EQUIPMENT ENDPOINTS
# ============================================================================
# Mock equipment runs in Docker containers on localhost

# Spectrum Analyzer Mock
MOCK_SPECTRUM_ANALYZER_IP=127.0.0.1
MOCK_SPECTRUM_ANALYZER_PORT=5001

# Signal Generator Mock
MOCK_SIGNAL_GENERATOR_IP=127.0.0.1
MOCK_SIGNAL_GENERATOR_PORT=5002

# DUT Mock
MOCK_DUT_IP=127.0.0.1
MOCK_DUT_PORT=5003

# ============================================================================
# RF PHYSICS SIMULATION PARAMETERS
# ============================================================================
# These parameters control the realism of the RF simulation

# Enable harmonic generation (2nd, 3rd, etc.)
MOCK_ENABLE_HARMONICS=true

# Harmonic order (how many harmonics to simulate)
# 2 = 2nd harmonic only
# 3 = 2nd and 3rd harmonics (recommended)
# 5 = up to 5th harmonic (very detailed)
MOCK_HARMONIC_ORDER=3

# Noise floor in dBm (thermal noise floor is -174 dBm/Hz + NF)
# -120 dBm is typical for spectrum analyzer with 10 dB NF and 1 kHz RBW
MOCK_NOISE_FLOOR_DBM=-120

# Enable intermodulation product simulation (IM3, IM5)
MOCK_ENABLE_INTERMOD=true

# ============================================================================
# ELASTICSEARCH CONFIGURATION
# ============================================================================
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200

# ============================================================================
# TEST CONFIGURATION
# ============================================================================
# Test timeout in seconds
TEST_TIMEOUT_SECONDS=300

# ============================================================================
# REAL EQUIPMENT ENDPOINTS (Used when USE_MOCK_EQUIPMENT=false)
# ============================================================================
# Uncomment and configure these if you want to run tests on real equipment

# SPECTRUM_ANALYZER_IP=192.168.50.10
# SPECTRUM_ANALYZER_PORT=5025

# SIGNAL_GENERATOR_IP=192.168.50.20
# SIGNAL_GENERATOR_PORT=5025

# DUT_IP=192.168.50.30
# DUT_PORT=5025

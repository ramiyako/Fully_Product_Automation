# AWS RF Automation Environment Configuration
# Auto-generated by aws_setup.sh
# Updated: 2026-03-05

# ============================================================================
# Environment
# ============================================================================
ENVIRONMENT=integration
DEPLOYMENT_TARGET=aws

# ============================================================================
# AWS Instance Information
# ============================================================================
AWS_INSTANCE_ID=i-0e14d354d2194366a
AWS_PUBLIC_IP=51.84.240.159
AWS_PRIVATE_IP=172.31.40.202
AWS_AVAILABILITY_ZONE=il-central-1a
AWS_REGION=il-central-1

# ============================================================================
# Service Endpoints (Public Access)
# ============================================================================
JENKINS_URL=http://51.84.240.159:8080
KIBANA_URL=http://51.84.240.159:5601
ELASTICSEARCH_URL=http://51.84.240.159:9200

# Service Endpoints (Internal)
JENKINS_INTERNAL_URL=http://localhost:8080
KIBANA_INTERNAL_URL=http://localhost:5601
ELASTICSEARCH_INTERNAL_URL=http://localhost:9200

# ============================================================================
# Mock Equipment Configuration
# ============================================================================
USE_MOCK_EQUIPMENT=true

# Spectrum Analyzer
MOCK_SA_HOST=localhost
MOCK_SA_SCPI_PORT=5001
MOCK_SA_HTTP_PORT=8001
MOCK_SA_URL=http://localhost:8001

# Signal Generator
MOCK_SG_HOST=localhost
MOCK_SG_SCPI_PORT=5002
MOCK_SG_HTTP_PORT=8002
MOCK_SG_URL=http://localhost:8002

# DUT (Device Under Test)
MOCK_DUT_HOST=localhost
MOCK_DUT_SCPI_PORT=5003
MOCK_DUT_HTTP_PORT=8003
MOCK_DUT_URL=http://localhost:8003

# ============================================================================
# RF Physics Simulation
# ============================================================================
ENABLE_RF_PHYSICS=true
ENABLE_HARMONICS=true
HARMONIC_ORDER=3
ENABLE_INTERMOD=true
NOISE_FLOOR_DBM=-120
PHASE_NOISE_ENABLED=true
FREQUENCY_OFFSET_PPM=0.5

# ============================================================================
# Test Configuration
# ============================================================================
TEST_TIMEOUT_SECONDS=300
TEST_RETRY_COUNT=3
TEST_LOG_LEVEL=INFO
PARALLEL_TEST_EXECUTION=false

# ============================================================================
# Elasticsearch Configuration
# ============================================================================
ES_HOST=localhost
ES_PORT=9200
ES_SCHEME=http
ES_INDEX_PREFIX=rf-automation
ES_UPLOAD_ENABLED=true
ES_RETENTION_DAYS=90

# Elasticsearch Resource Limits
ES_JAVA_OPTS=-Xms1g -Xmx1g
ES_HEAP_SIZE=1g

# ============================================================================
# Kibana Configuration
# ============================================================================
KIBANA_HOST=localhost
KIBANA_PORT=5601
KIBANA_SERVER_NAME=rf-automation-kibana

# ============================================================================
# Jenkins Configuration
# ============================================================================
JENKINS_HOST=localhost
JENKINS_PORT=8080
JENKINS_HOME=/var/lib/jenkins
JENKINS_WORKSPACE=/var/lib/jenkins/workspace

# ============================================================================
# Allure Reporting
# ============================================================================
ALLURE_RESULTS_DIR=/app/allure-results
ALLURE_REPORT_DIR=/app/allure-report
ALLURE_GENERATE_REPORT=true
ALLURE_SERVE_REPORT=false
ALLURE_PUBLIC_URL=http://51.84.240.159:9080
ALLURE_INTERNAL_URL=http://localhost:9080
ALLURE_PORT=9080
ALLURE_NGINX_ENABLED=true

# ============================================================================
# Docker Configuration
# ============================================================================
DOCKER_NETWORK=rf-integration-network
COMPOSE_PROJECT_NAME=rf-automation
COMPOSE_FILE=docker-compose.aws.yml

# Docker Resource Limits
DOCKER_MEMORY_LIMIT=512m
DOCKER_CPU_LIMIT=0.5

# ============================================================================
# Logging Configuration
# ============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_DIR=/var/log/rf-automation
LOG_RETENTION_DAYS=30
LOG_MAX_SIZE=100m
LOG_MAX_FILES=5

# ============================================================================
# Security Configuration
# ============================================================================
# NOTE: For production, enable security and configure credentials
ES_SECURITY_ENABLED=false
KIBANA_SECURITY_ENABLED=false
JENKINS_SECURITY_ENABLED=true

# ============================================================================
# Monitoring & Health Checks
# ============================================================================
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=5
HEALTH_CHECK_START_PERIOD=90s

# ============================================================================
# Backup Configuration
# ============================================================================
BACKUP_ENABLED=false
BACKUP_DIR=/backup
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM

# ============================================================================
# Performance Tuning
# ============================================================================
# System
VM_MAX_MAP_COUNT=262144
FS_FILE_MAX=65535

# Network
NET_CORE_SOMAXCONN=1024
NET_IPV4_TCP_MAX_SYN_BACKLOG=2048

# ============================================================================
# Feature Flags
# ============================================================================
FEATURE_AUTO_REFRESH_ALLURE=true
FEATURE_HTML_MARKUP_FORMATTER=true
FEATURE_CLICKABLE_LINKS=true
FEATURE_SERVICE_URLS_ON_BUILD=true

# ============================================================================
# Notification Configuration (Optional)
# ============================================================================
NOTIFICATIONS_ENABLED=false
SLACK_WEBHOOK_URL=
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_SMTP_SERVER=
EMAIL_SMTP_PORT=587
EMAIL_FROM=
EMAIL_TO=

# ============================================================================
# Advanced Configuration
# ============================================================================
# Robot Framework
ROBOT_THREADS=1
ROBOT_VARIABLE_FILE=config/integration.py
ROBOT_OUTPUT_DIR=/app/results

# Python
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
PYTHON_VERSION=3.11

# Time Zone
TZ=UTC
